# Dictionary for BroadcastEnvelope MessagePack deserialization.
# BroadcastEnvelope wraps AES-256-GCM encrypted broadcast content from
# the sender-key broadcast sub-protocol (spec §5.14).

# BroadcastEnvelope field names (from serde attributes in broadcast.rs)
"version"
"context_id"
"author_did"
"sequence"
"timestamp"
"key_epoch"
"provenance"
"signature"
"nonce"
"encrypted_content"

# Optional provenance field names (DataProvenance)
"source_context_id"
"source_sequence"
"source_author_did"
"attestation"

# MessagePack fixmap headers (0x8N = N-field map)
"\x81"
"\x82"
"\x83"
"\x84"
"\x85"
"\x86"
"\x87"
"\x88"
"\x89"
"\x8a"
"\x8b"
"\x8c"

# MessagePack fixarray headers
"\x91"
"\x92"
"\x93"
"\x94"
"\x95"

# MessagePack uint16 / uint32 / uint64 headers
"\xcd"
"\xce"
"\xcf"

# MessagePack int64 header
"\xd3"

# MessagePack bin8 / bin16 / bin32 headers (signature, nonce, encrypted_content)
"\xc4"
"\xc5"
"\xc6"

# MessagePack str8 / str16 headers (DID strings, context_id)
"\xd9"
"\xda"

# nil (optional provenance), true, false
"\xc0"
"\xc2"
"\xc3"

# Fixed 64-byte signature (bin8 of 64)
"\xc4\x40"

# Fixed 12-byte nonce (bin8 of 12)
"\xc4\x0c"

# Protocol version 0x0100 encoded as uint16
"\xcd\x01\x00"

# DID prefix
"did:dht:"

# Common large encrypted_content (bin16)
"\xc5"
