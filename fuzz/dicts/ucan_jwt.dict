# Dictionary for UCAN JWT token parsing (fuzz_parse_ucan)
# UCAN JWT is structured as base64url(header).base64url(payload).base64url(sig)
# These tokens help the fuzzer discover meaningful JWT structure.

# Structural separator
"."

# JSON field names — header
"alg"
"EdDSA"
"ES256"
"typ"
"JWT"
"ucv"
"0.10.0"
"kid"
"#active"
"#agent"

# JSON field names — payload
"iss"
"aud"
"exp"
"nbf"
"att"
"prf"
"nnc"
"fct"
"with"
"can"

# Capability actions
"*"
"read"
"write"
"propose"
"invoke"

# Base64url alphabet (helps mutate encoded segments meaningfully)
"ABCDEFGHIJKLMNOPQRSTUVWXYZ"
"abcdefghijklmnopqrstuvwxyz"
"0123456789"
"-_"

# DID prefixes
"did:dht:"
"did:web:"
"did:key:"

# SCP-specific URIs in UCAN
"scp:ctx:"
"messages:write"
"messages:read"

# Outlet capability URIs (SCP-OUT-014 — split stems landed).
# Wire form uses underscore (`outlet_query:`, `outlet_call:`) — these are
# the canonical UCAN resource strings; SDK-facing display form uses colon
# (`outlet:query:`, `outlet:call:`) per ADR-049 §1 and spec §5.4.2.1.
# Both forms must round-trip through `Capability::new` and reject invalid
# suffixes (empty, uppercase, inner colon, > 128 bytes).
"outlet_query:*"
"outlet_call:*"
"outlet:query:*"
"outlet:call:*"

# Negative-input corpus per SCP-OUT-014 / ADR-049 §1 hard break:
# the deleted `outlet_invoke:` and pre-rename `tool_invoke:` stems must
# parse to `None`. Including them as fuzzer tokens lets the parser
# differential exercise rejection paths on every iteration.
"outlet_invoke:*"
"tool_invoke:*"
