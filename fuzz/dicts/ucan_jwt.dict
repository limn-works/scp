# Dictionary for UCAN JWT token parsing (fuzz_parse_ucan)
# UCAN JWT is structured as base64url(header).base64url(payload).base64url(sig)
# These tokens help the fuzzer discover meaningful JWT structure.

# Structural separator
"."

# JSON field names — header
"alg"
"EdDSA"
"ES256"
"typ"
"JWT"
"ucv"
"0.10.0"
"kid"
"#active"
"#agent"

# JSON field names — payload
"iss"
"aud"
"exp"
"nbf"
"att"
"prf"
"nnc"
"fct"
"with"
"can"

# Capability actions
"*"
"read"
"write"
"propose"
"invoke"

# Base64url alphabet (helps mutate encoded segments meaningfully)
"ABCDEFGHIJKLMNOPQRSTUVWXYZ"
"abcdefghijklmnopqrstuvwxyz"
"0123456789"
"-_"

# DID prefixes
"did:dht:"
"did:web:"
"did:key:"

# SCP-specific URIs in UCAN
"scp:ctx:"
"messages:write"
"messages:read"

# Outlet capability URIs (SCP-OUT-008 — post-rename vocabulary).
# Wire form uses underscore; SDK-facing display form uses colon (ADR-049 §1).
# The split outlet_query: / outlet_call: stems land in SCP-OUT-020; this
# story adds outlet_invoke: as a placeholder so the fuzzer still exercises
# the capability-URI parser on outlet-vocabulary tokens.
"outlet_invoke:*"
"outlet_query:*"
"outlet_call:*"
"outlet:query:*"
"outlet:call:*"

# Retained: legacy tool_invoke:* is an INVALID-input corpus entry per ADR-049
# (hard break, no aliases). The fuzzer should exercise rejection of the
# legacy form — either as `OldFormatRejected` or as
# `OutletErrorClass::Protocol::UnknownOperation`.
"tool_invoke:*"
