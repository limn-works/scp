# Dictionary for SerializedBlob MessagePack deserialization (redb_blob.rs).
# SerializedBlob is the internal wire format stored in the redb blobs table.
# Field names from the private SerializedBlob struct in scp-transport.

# SerializedBlob field names
"routing_id"
"blob_id"
"recipient_hint"
"blob_ttl"
"stored_at"
"expires_at"
"blob"

# MessagePack fixmap headers (0x8N = N-field map)
"\x81"
"\x82"
"\x83"
"\x84"
"\x85"
"\x86"
"\x87"
"\x88"

# MessagePack fixarray headers
"\x91"
"\x92"
"\x93"
"\x94"

# MessagePack uint32 / uint64 headers (ttl, timestamps)
"\xce"
"\xcf"

# MessagePack int8 / int64 headers
"\xd0"
"\xd3"

# MessagePack bin8 / bin16 / bin32 (binary fields)
"\xc4"
"\xc5"
"\xc6"

# MessagePack str8 / str16
"\xd9"
"\xda"

# nil (optional recipient_hint), true, false
"\xc0"
"\xc2"
"\xc3"

# Common 32-byte binary fields (routing_id, blob_id, recipient_hint each 32 bytes)
"\xc4\x20"

# Common large blob prefix (bin16 up to 64 KiB)
"\xc5"

# Max uint32 (TTL boundary)
"\xce\xff\xff\xff\xff"

# Max uint64 (timestamp boundary)
"\xcf\xff\xff\xff\xff\xff\xff\xff\xff"
