# Dictionary for OuterEnvelope MessagePack deserialization.
# Field names from the serde attributes of OuterEnvelope.
# MessagePack format bytes for common structural tokens.

# Field names
"version"
"routing_id"
"blob_ttl"
"encrypted_blob"
"recipient_hint"
"extensions"

# MessagePack fixmap headers (0x8N where N = number of fields)
"\x81"
"\x82"
"\x83"
"\x84"
"\x85"
"\x86"
"\x87"
"\x88"

# MessagePack fixarray headers
"\x91"
"\x92"
"\x93"
"\x94"
"\x95"
"\x96"

# MessagePack integer encodings
"\x00"
"\x01"
"\xff"
"\xcd"
"\xce"
"\xcf"

# MessagePack bin8/bin16/bin32 headers (binary data)
"\xc4"
"\xc5"
"\xc6"

# MessagePack str8/str16 headers
"\xd9"
"\xda"
"\xdb"

# MessagePack nil, true, false
"\xc0"
"\xc2"
"\xc3"

# Protocol version (SCP/1.0 = 0x0100 = 256 as uint16)
"\xcd\x01\x00"

# Common routing_id length (32 bytes) as bin8
"\xc4\x20"

# Common blob sizes: 512, 4096, 65536
"\xcd\x02\x00"
"\xcd\x10\x00"
"\xce\x00\x01\x00\x00"
