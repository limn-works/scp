# Dictionary for ScpCredential MessagePack deserialization.
# Fields from ScpCredential struct serde attributes.

# ScpCredential field names
"did"
"ucan_token"
"signing_key_id"

# SigningKeyId variant strings
"Active"
"Agent"
"Custom"

# MessagePack fixmap headers
"\x81"
"\x82"
"\x83"
"\x84"

# MessagePack fixarray headers
"\x91"
"\x92"
"\x93"

# Integer encodings
"\x00"
"\x01"
"\xcd"

# Binary field headers
"\xc4"
"\xc5"
"\xc6"

# String field headers
"\xd9"
"\xda"

# nil (optional ucan_token = None)
"\xc0"
"\xc2"
"\xc3"

# DID prefix
"did:dht:"
"did:web:"

# UCAN JWT prefix tokens
"eyJ"
"."
