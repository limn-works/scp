# Dictionary for SenderKeyDistributionMessage MessagePack deserialization.
# Covers all msg_type variants and their fields.

# The msg_type discriminator field
"msg_type"

# SenderKeyDistributionMessage variant tag values
"key_response"
"key_request"
"epoch_advance"
"block_notification"

# SenderKeyResponse fields
"epoch"
"chain_key"
"sender_index"
"signature"
"sender_did"
"context_id"
"key_id"

# SenderKeyRequest fields (also shares epoch, sender_did, context_id)
"nonce"
"timestamp"

# EpochAdvance fields
"new_epoch"
"prev_chain_key_hash"

# BlockNotification fields
"blocked_did"
"blocker_did"
"new_sender_key"

# MessagePack fixmap headers
"\x81"
"\x82"
"\x83"
"\x84"
"\x85"
"\x86"
"\x87"
"\x88"

# MessagePack fixarray headers
"\x91"
"\x92"
"\x93"

# Integer encodings
"\x00"
"\x01"
"\xcd"
"\xce"
"\xcf"

# Binary field headers
"\xc4"
"\xc5"
"\xc6"

# String field headers
"\xd9"
"\xda"

# nil, true, false
"\xc0"
"\xc2"
"\xc3"

# Common 32-byte key material (bin8 of 32)
"\xc4\x20"

# Common 64-byte signature (bin8 of 64)
"\xc4\x40"

# DID prefix (common prefix for did:dht values)
"did:dht:"
