# Dictionary for ClientMessage MessagePack deserialization.
# Covers all op variants and their fields.

# The op discriminator field
"op"

# ClientMessage op variant strings
"PUBLISH"
"SUBSCRIBE"
"UNSUBSCRIBE"
"QUERY"
"DELETE"
"ACK"
"PING"
"BRIDGE_REGISTER"
"BRIDGE_DATA"
"AUTHENTICATE"

# Common fields across op variants
"routing_id"
"blob"
"blob_id"
"blob_ttl"
"recipient_hint"
"ref_id"
"limit"
"after"
"token"

# MessagePack fixmap headers (map with N items)
"\x81"
"\x82"
"\x83"
"\x84"
"\x85"
"\x86"
"\x87"
"\x88"

# MessagePack fixarray headers
"\x91"
"\x92"
"\x93"
"\x94"
"\x95"

# Integer encodings
"\x00"
"\x01"
"\xcd"
"\xce"
"\xcf"

# Binary field headers
"\xc4"
"\xc5"
"\xc6"

# String field headers
"\xd9"
"\xda"

# nil, true, false
"\xc0"
"\xc2"
"\xc3"

# Common routing_id (32 bytes bin8)
"\xc4\x20"

# Common blob_id (32 bytes bin8)
"\xc4\x20"

# Common blob_ttl range (30s to 86400s in msgpack uint)
"\xcd\x00\x1e"
"\xce\x00\x01\x51\x80"
