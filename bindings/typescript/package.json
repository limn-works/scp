{
  "name": "@limn-works/scp-ts",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "lint": "biome check src/ tests/",
    "format": "biome format --write src/ tests/",
    "test": "bun test"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.0"
  },
  "dependencies": {
    "wa-sqlite": "^1.0.0"
  },
  "optionalDependencies": {
    "@limn-works/scp-ts-napi-linux-x64-gnu": "0.1.0",
    "@limn-works/scp-ts-napi-linux-arm64-gnu": "0.1.0",
    "@limn-works/scp-ts-napi-darwin-x64": "0.1.0",
    "@limn-works/scp-ts-napi-darwin-arm64": "0.1.0",
    "@limn-works/scp-ts-napi-win32-x64-msvc": "0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/node": "^25.3.2",
    "tsup": "latest",
    "typedoc": "^0.27.0",
    "typedoc-plugin-markdown": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
