# SwiftFormat configuration for SCP Swift SDK
# SwiftLint's trailing_comma rule forbids trailing commas;
# disable SwiftFormat's trailingCommas rule to avoid conflict.
--disable trailingCommas

# SwiftLint's opening_brace rule keeps braces on the same line;
# disable SwiftFormat's wrapMultilineStatementBraces to avoid conflict.
--disable wrapMultilineStatementBraces

# Exclude auto-generated UniFFI bindings
--exclude Sources/SCP/Internal,.build,.build-xcframework,ScpFFI.xcframework
