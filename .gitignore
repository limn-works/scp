# OS
.DS_Store

# Rust
target/
# `.github/workflows/build-matrix.yml` builds each uploaded bridge binary here,
# one package per invocation, so no `cargo test` step overwrites an artifact a
# release job then Authenticode-signs.
target-shipped/
rust_out

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# TypeScript
node_modules/
dist/

# Swift
bindings/swift/.build/

# Kotlin
bindings/kotlin/.gradle/
bindings/kotlin/**/build/
# UniFFI-generated Kotlin bindings (regenerated from Rust source)
bindings/kotlin/scp-kt/src/main/kotlin/works/limn/scp/internal/*.kt

# Native build artifacts
*.node
*.wasm
*.so
*.dylib

