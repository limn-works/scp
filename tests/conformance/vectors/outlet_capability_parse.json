{
  "version": "v1",
  "spec_section": ".docs/specs/05-contexts.md §5.4.2.1 UCAN Capability Stem Parser",
  "adr": ".docs/adrs/ADR-049-outlet-redesign.md §1, §2",
  "story": "SCP-OUT-014",
  "description": "Conformance vectors for the §5.4.2.1 outlet capability stem parser. Every bridge (PyO3, NAPI, UniFFI Swift, UniFFI Kotlin, WASM) must accept every positive vector and reject every negative vector identically — divergence is a parser-differential bug that allows authorization-class confusion. The Rust core's scp_protocol::context::roles::Capability::new is the reference implementation; bridges MAY add wrapper validation but MUST NOT weaken the rejection criteria.",
  "rules": [
    "Wire form: `outlet_query:` / `outlet_call:` (UCAN resource string).",
    "SDK display form: `outlet:query:` / `outlet:call:` (round-trips through Display).",
    "Suffix must be `*` (wildcard) or `^[a-z0-9_-]{1,128}$`.",
    "`outlet:invoke:` / `outlet_invoke:` are HARD-BREAK deleted (ADR-049 §1).",
    "`tool:invoke:` / `tool_invoke:` / `tool:register` / `tool:interface` are pre-rename legacy (rejected).",
    "Inner colons in the suffix (`outlet_query:call:foo`) are rejected (parser-differential guard).",
    "Empty suffix (`outlet_query:`) is rejected.",
    "Uppercase characters in the suffix are rejected (case-sensitive regex).",
    "Suffix length > 128 bytes is rejected.",
    "Non-ASCII bytes in the suffix are rejected."
  ],
  "positive": [
