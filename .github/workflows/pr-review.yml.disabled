name: PR Review

on:
  pull_request:
    types: [opened, synchronize, ready_for_review]
    paths:
      - 'crates/**'
      - 'bindings/**'
      - 'tests/**'
      - 'scripts/**'
      - '.docs/**'
      - 'Cargo.toml'
      - 'Cargo.lock'

concurrency:
  group: pr-review-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  review:
    if: |
      github.event.pull_request.draft == false &&
      github.actor != 'dependabot[bot]' &&
      !contains(github.event.pull_request.labels.*.name, 'prd-story')
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
      id-token: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v5
        with:
          fetch-depth: 0

      - name: Compute review scope
        id: diff
        run: |
          EVENT="${{ github.event.action }}"
          BEFORE="${{ github.event.before }}"
          AFTER="${{ github.event.after }}"
          PR_BASE="${{ github.event.pull_request.base.sha }}"
          HEAD="${{ github.event.pull_request.head.sha }}"

          if [[ "$EVENT" == "synchronize" && "$BEFORE" != "0000000000000000000000000000000000000000" ]]; then
            MODE="incremental"
            DIFF_BASE="$BEFORE"
            DIFF_HEAD="$AFTER"
          else
            MODE="full"
            DIFF_BASE="$PR_BASE"
            DIFF_HEAD="$HEAD"
          fi

          echo "mode=$MODE" >> "$GITHUB_OUTPUT"
          echo "diff_head=$DIFF_HEAD" >> "$GITHUB_OUTPUT"

          # Write raw file list, then filter to in-scope paths
          if ! git diff --name-only "$DIFF_BASE".."$DIFF_HEAD" > /tmp/all-changed-files.txt 2>/dev/null; then
            # BEFORE sha is unreachable (force push) — fall back to full PR diff
            MODE="full"
            DIFF_BASE="$PR_BASE"
            DIFF_HEAD="$HEAD"
            echo "mode=$MODE" >> "$GITHUB_OUTPUT"
            gh pr view ${{ github.event.pull_request.number }} --json files --jq '.files[].path' > /tmp/all-changed-files.txt
          fi

          grep -E '^(crates/|bindings/|tests/|scripts/|\.docs/|Cargo\.(toml|lock)$)' /tmp/all-changed-files.txt > /tmp/changed-files.txt || true

          FILE_COUNT=$(wc -l < /tmp/changed-files.txt | tr -d ' ')
          echo "file_count=$FILE_COUNT" >> "$GITHUB_OUTPUT"

          if [[ "$FILE_COUNT" -eq 0 ]]; then
            echo "No in-scope files changed — skipping review."
            exit 0
          fi

          # Write diff content (only in-scope files)
          git diff "$DIFF_BASE".."$DIFF_HEAD" -- $(cat /tmp/changed-files.txt) > /tmp/scope-diff.patch || \
            gh pr diff ${{ github.event.pull_request.number }} > /tmp/scope-diff.patch

          echo "## Review Scope" > /tmp/review-scope.md
          echo "**Mode:** $MODE" >> /tmp/review-scope.md
          echo "**Range:** \`${DIFF_BASE:0:8}..${DIFF_HEAD:0:8}\`" >> /tmp/review-scope.md
          echo "**Files in scope:** $FILE_COUNT" >> /tmp/review-scope.md
          echo "" >> /tmp/review-scope.md
          echo "### Changed files" >> /tmp/review-scope.md
          cat /tmp/changed-files.txt >> /tmp/review-scope.md
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Fetch review history
        if: steps.diff.outputs.file_count != '0'
        run: |
          PR=${{ github.event.pull_request.number }}
          REPO="${{ github.repository }}"
          OWNER="${{ github.repository_owner }}"
          REPO_NAME="${{ github.event.repository.name }}"

          echo "## Previous Review Threads" > /tmp/review-history.md

          # Inline review threads with resolution status (GraphQL)
          gh api graphql -f query='
          {
            repository(owner: "'"$OWNER"'", name: "'"$REPO_NAME"'") {
              pullRequest(number: '"$PR"') {
                reviewThreads(first: 100) {
                  nodes {
                    isResolved
                    isOutdated
                    path
                    line
                    comments(first: 5) {
                      nodes {
                        body
                        author { login }
                        createdAt
                      }
                    }
                  }
                }
              }
            }
          }' --jq '.data.repository.pullRequest.reviewThreads.nodes' > /tmp/review-threads.json 2>/dev/null || echo "[]" > /tmp/review-threads.json

          THREAD_COUNT=$(jq length /tmp/review-threads.json)
          if [[ "$THREAD_COUNT" -gt 0 ]]; then
            echo "" >> /tmp/review-history.md
            echo "**$THREAD_COUNT thread(s) found.**" >> /tmp/review-history.md
            echo "" >> /tmp/review-history.md
            jq -r '.[] | "- [\(if .isResolved then "RESOLVED" elif .isOutdated then "OUTDATED" else "OPEN" end)] \(.path):\(.line) — \(.comments.nodes[0].body | .[0:200])"' /tmp/review-threads.json >> /tmp/review-history.md
          else
            echo "" >> /tmp/review-history.md
            echo "No previous review threads." >> /tmp/review-history.md
          fi

          # Previous review verdicts
          echo "" >> /tmp/review-history.md
          echo "## Previous Review Verdicts" >> /tmp/review-history.md
          gh api "repos/$REPO/pulls/$PR/reviews" \
            --jq '.[] | "- \(.state) by \(.user.login) at \(.submitted_at): \(.body | .[0:300])"' >> /tmp/review-history.md 2>/dev/null || echo "None." >> /tmp/review-history.md

          # PR-level comments
          echo "" >> /tmp/review-history.md
          echo "## Previous PR Comments" >> /tmp/review-history.md
          gh api "repos/$REPO/issues/$PR/comments" \
            --jq '.[] | "- \(.user.login) at \(.created_at): \(.body | .[0:300])"' >> /tmp/review-history.md 2>/dev/null || echo "None." >> /tmp/review-history.md
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Run Claude PR review
        if: steps.diff.outputs.file_count != '0'
        continue-on-error: true
        uses: anthropics/claude-code-action@v1
        with:
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
          show_full_output: true
          claude_args: '--model claude-opus-4-20250514 --max-turns 100 --allowedTools "Bash,Read,Glob,Grep,Task"'
          prompt: |
            You are reviewing PR #${{ github.event.pull_request.number }}: "${{ github.event.pull_request.title }}"

            ## Setup

            Read the review scope and history (pre-computed):
            1. Read `/tmp/review-scope.md` — the files and diff range in scope
            2. Read `/tmp/review-history.md` — all previous review threads and verdicts
            3. Read `/tmp/scope-diff.patch` — the actual diff to review

            This review is in **${{ steps.diff.outputs.mode }}** mode.
            - **full**: Review all changes. This is the first review or the PR just left draft.
            - **incremental**: Review ONLY the latest push. Do not re-review unchanged code.

            ## History Rules

            - **RESOLVED threads**: Already fixed. Do NOT re-flag.
            - **OUTDATED threads**: Code changed since comment. Check if new code fixes the concern.
              If fixed, skip. If same issue persists, re-flag referencing the original.
            - **OPEN threads**: Still active on unchanged code. Do NOT duplicate. If the file is in
              your review scope and the issue persists, you may add a follow-up.
            - **Previous verdicts**: If changes were previously requested, check whether this push
              addresses them. Note resolved items and flag remaining ones.

            ## Perspectives

            Review the PR from these 6 perspectives. For each, read the agent file first:

            ### 1. Architecture (read `.claude/agents/architecture-reviewer.md`)
            - Completeness, scalability, maintainability
            - ADR compliance — do changes follow existing decisions?
            - Pattern consistency — does this establish or break patterns?

            ### 2. Security (read `.claude/agents/security-reviewer.md`)
            - Authentication/authorization issues
            - Input validation, injection risks
            - Secrets exposure, error message leakage

            ### 3. Alignment (read `.claude/agents/alignment-reviewer.md`)
            - Does implementation match the spec/issue it addresses?
            - Does it serve the product vision from `.docs/architecture.md`?
            - Will it create problems for future phases?

            ### 4. API Design (read `.claude/agents/api-design-reviewer.md`)
            - Discoverability, misuse resistance
            - Consistency with existing APIs
            - Developer experience

            ### 5. Code Quality (read `.claude/agents/bug-catcher.md`)
            - Actual bugs: crashes, logic errors, concurrency issues
            - Incorrect assumptions about data or state
            - Edge cases and error handling gaps

            ### 6. Completeness & Gap Detection

            This is the **highest-priority perspective**. The most common failure mode
            in this codebase is code that compiles and passes tests but is incomplete —
            stubs, missing wiring, SDK gaps, dropped nuance. Hunt aggressively.

            **Stubs & Placeholders (textual AND semantic)**

            Textual stubs are easy — grep for them. Semantic stubs are the real threat:
            code that looks complete, compiles, passes tests, but does nothing meaningful.

            *Textual (grep these):*
            - `todo!()`, `unimplemented!()`, `// Stub`, `// TODO`, `// FIXME`, `// HACK`
            - `placeholder`, `Default::default()` used where a real value should exist
            - `None` assignments where the spec defines a real value

            *Semantic (trace these — they won't show up in grep):*
            - **Empty implementations**: function body is just `Ok(())`, `Ok(vec![])`,
              `Ok(Default::default())`, `Ok(0)`, or returns a hardcoded/empty value
              when the spec requires real logic. Read the function name and signature —
              does the body actually do what the name promises?
            - **Pass-through wrappers**: function that takes 5 parameters but only uses
              2 of them — the others are ignored rather than wired through
            - **Silently swallowed errors**: `.ok()`, `.unwrap_or_default()`,
              `let _ = fallible_call()`, `if let Ok(x) = ... { } // no else` — where
              the error path has real consequences the caller should handle
            - **Hardcoded logic**: match arms that return the same value for every
              variant, config values that ignore their input, validation functions
              that always return true
            - **Incomplete iterations**: `iter().next()` or `.first()` when the spec
              says "for each" or "all" — processing only the first item
            - **Shallow delegation**: a public function calls one inner function but
              the spec requires multiple steps (validate, transform, store, notify) —
              check that ALL steps are present, not just the first
            - **Dead parameters**: struct fields set in the constructor but never read,
              function parameters accepted but never referenced in the body
            - **Hollow types**: struct defined with all fields but no methods that
              actually use those fields, or methods that don't touch the struct's state
            - **Missing side effects**: function updates one store but the spec says
              it must update two stores, emit an event, AND notify subscribers

            *Path tracing (follow the code):*
            For each significant function in the diff, trace ONE complete path from
            public API entry to final effect. At each step ask: does this actually
            do what the caller expects? Specifically:
            - Does the return value actually contain the data the caller will use?
            - If it stores something, can it be retrieved by the corresponding read?
            - If it validates, does it actually reject invalid input (test with a
              concrete bad example)?
            - If it transforms, does the output have all fields populated?

            **Wiring Gaps**
            - New types/functions defined but never called or registered
            - New enum variants defined but not matched in relevant `match` arms
            - New trait methods with default impls that should be overridden by
              concrete implementations
            - Public API added in core but not exported through FFI bridge
              (`crates/scp-ffi/`) — check PyO3, UniFFI, NAPI, WASM targets
            - FFI bridge function added but not wrapped in language SDK
              (`bindings/python/`, `bindings/typescript/`, `bindings/swift/`,
              `bindings/kotlin/`)

            **SDK Divergence**
            - If changes touch core types or public APIs, check whether ALL SDK bindings
              reflect the change. Build a matrix:
              | Operation | Core | PyO3 | UniFFI | NAPI | WASM | Python SDK | TS SDK | Swift SDK | Kotlin SDK |
              Missing cells are findings.
            - SDK wrapper signatures must match FFI bridge signatures — watch for
              missing parameters, wrong types, swapped argument order
            - Error types added in core must have corresponding error variants in
              each SDK's error mapping

            **Implied & Skipped Requirements**
            - Identify the spec sections relevant to the changed code (use path-to-spec
              mapping from the spec-drift workflow). Read those sections.
            - Look for:
              - Conditional language ("unless", "except when", "only if") that
                should produce explicit branches or error cases in the code
              - Enumerated lists in the spec (e.g., "supports X, Y, and Z") where
                the implementation only covers X and Y
              - Security constraints ("MUST verify", "MUST NOT allow") that need
                enforcement code, not just comments
              - Edge cases mentioned in the spec that have no test
            - Compare the spec's level of detail against the implementation's level
              of detail. If the spec has 5 sub-requirements and the code has 2 branches,
              3 are likely missing.

            ## Self-Validation (MANDATORY before reporting)

            Before writing ANY output, re-examine every finding you intend to report.
            For each finding, answer these three questions:

            1. **Is it factually true?** Re-read the actual code (not your summary of it).
               Verify line numbers, function names, type names, and logic. If you cannot
               point to a specific line that proves the finding, drop it.
            2. **No dismissals.** A finding is valid if:
               - The code does something the spec/story says it should not, OR
               - The code does NOT do something the spec/story says it should, OR
               - The code has a bug (crash, logic error, data loss, security flaw), OR
               - The code is incomplete (stub, placeholder, missing wiring, SDK gap)
               ALL factual findings are valid regardless of scope, perceived relevance,
               pre-existence, or subjectivity. Do NOT dismiss a real gap because "it was
               already like that" or "it's out of scope for this PR" — flag it. The only
               findings to drop are ones that are factually wrong.
            3. **Can I prove it — and can I disprove it?** For each finding, you must:
               - **Prove it:** cite file path, line number, and the specific code or
                 absence that constitutes the issue. "I think X might be missing" is
                 not a finding. "`transport.rs:142` handles variant A and B but the
                 spec lists A, B, and C — variant C has no match arm" is.
               - **Try to disprove it:** actively search for evidence that contradicts
                 your finding. If you claim "X is not wired to Y," search Y's file for
                 X — grep for the function name, type name, import. If you claim "no
                 test exists for Z," search the test directories for Z. If you find
                 counter-evidence, drop the finding. Only report what survives both
                 checks.

            Drop any finding that fails check 1 or 3.

            ## Output

            For each NEW issue (not previously flagged), post an inline review comment on the specific line(s) using:
            ```bash
            gh api repos/${{ github.repository }}/pulls/${{ github.event.pull_request.number }}/comments \
              -f body="<comment>" -f path="<file>" -f commit_id="${{ steps.diff.outputs.diff_head }}" -F line=<line> -f side=RIGHT
            ```

            ONLY comment on files listed in /tmp/changed-files.txt.

            ## When to post a review verdict

            **In incremental mode**: Only post a verdict if you have new findings (inline comments,
            newly resolved requested-changes, or status changes worth reporting). If the incremental
            diff introduces no new issues and there are no previous requested-changes to clear,
            exit silently — do not post an empty approval or "no issues" comment.

            **In full mode**: Always post a verdict (this is the first review).

            ## Verdict format

            If there are critical issues that must be fixed:
            ```bash
            gh pr review ${{ github.event.pull_request.number }} --request-changes --body "<summary>"
            ```

            If there are only notes/suggestions (no critical or warning):
            ```bash
            gh pr review ${{ github.event.pull_request.number }} --comment --body "<summary>"
            ```

            If there are no issues and you need to clear a previous request-changes, or this is a full review:
            ```bash
            gh pr review ${{ github.event.pull_request.number }} --approve --body "<summary>"
            ```

            The summary must include:
            - **Review mode**: ${{ steps.diff.outputs.mode }}
            - **Files reviewed**: count from /tmp/changed-files.txt
            - **History reconciliation**: which previous findings were resolved, which remain
            - A section per perspective (all 6, including Completeness & Gap Detection)
              with key findings (or "No issues found")
            - Total issue count by severity (critical / warning / note)

            If no issues are found across all perspectives, say so clearly — don't invent problems.
