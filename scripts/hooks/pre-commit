#!/usr/bin/env bash
# Pre-commit hook: lint + format for all languages (parallel).
# Only checks languages with staged changes.
set -euo pipefail

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$STAGED" ] && exit 0

HAS_RUST=false
HAS_PYTHON=false
HAS_TS=false
HAS_KOTLIN=false
HAS_SWIFT=false

for f in $STAGED; do
  case "$f" in
    *.rs) HAS_RUST=true ;;
    bindings/python/*) HAS_PYTHON=true ;;
    bindings/typescript/*) HAS_TS=true ;;
    bindings/kotlin/*) HAS_KOTLIN=true ;;
    bindings/swift/*) HAS_SWIFT=true ;;
  esac
done

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

# Each language block writes to its own result file.
# Exit code 0 = pass, non-zero = fail.

if $HAS_RUST; then
  (
    echo "▸ Rust: fmt + clippy + WASM + protocol enforcement"
    cargo fmt --all -- --check 2>&1 || { echo "  ✗ cargo fmt failed. Run: cargo fmt --all"; exit 1; }
    cargo clippy --workspace --all-targets \
      --features scp-ffi-uniffi/allow_in_memory_custody,scp-ffi/allow_in_memory_custody,scp-ffi-napi/allow_in_memory_custody,scp-core/testing,scp-runtime/testing \
      -- -D warnings 2>&1 || { echo "  ✗ clippy failed"; exit 1; }
    cargo clippy -p scp-ffi-wasm --target wasm32-unknown-unknown -- -D warnings 2>&1 || { echo "  ✗ WASM clippy failed"; exit 1; }
    python3.12 scripts/check-protocol-sync.py 2>&1 || { echo "  ✗ async code in scp-protocol"; exit 1; }
    bash scripts/check-protocol-deps.sh 2>&1 || { echo "  ✗ banned deps in scp-protocol"; exit 1; }
  ) > "$TMPDIR/rust.log" 2>&1 && touch "$TMPDIR/rust.ok" &
fi

if $HAS_PYTHON; then
  (
    echo "▸ Python: ruff format + check"
    python3.12 -m ruff format --check bindings/python/ 2>&1 || { echo "  ✗ ruff format failed. Run: python3.12 -m ruff format bindings/python/"; exit 1; }
    python3.12 -m ruff check bindings/python/ 2>&1 || { echo "  ✗ ruff check failed"; exit 1; }
  ) > "$TMPDIR/python.log" 2>&1 && touch "$TMPDIR/python.ok" &
fi

if $HAS_TS; then
  (
    echo "▸ TypeScript: biome lint + tsc check"
    cd bindings/typescript
    bun run lint 2>&1 || { echo "  ✗ biome lint failed"; exit 1; }
    bun run check 2>&1 || { echo "  ✗ tsc check failed"; exit 1; }
  ) > "$TMPDIR/ts.log" 2>&1 && touch "$TMPDIR/ts.ok" &
fi

if $HAS_KOTLIN; then
  (
    echo "▸ Kotlin: detekt"
    eval "$(mise env)" 2>/dev/null || true
    cd bindings/kotlin
    ./gradlew detekt 2>&1 || { echo "  ✗ detekt failed"; exit 1; }
  ) > "$TMPDIR/kotlin.log" 2>&1 && touch "$TMPDIR/kotlin.ok" &
fi

if $HAS_SWIFT; then
  (
    echo "▸ Swift: swiftlint + swiftformat"
    cd bindings/swift
    swiftlint --strict 2>&1 || { echo "  ✗ swiftlint failed"; exit 1; }
    swiftformat --lint . 2>&1 || { echo "  ✗ swiftformat failed"; exit 1; }
  ) > "$TMPDIR/swift.log" 2>&1 && touch "$TMPDIR/swift.ok" &
fi

# Wait for all background jobs
wait

# Check results and print failures
FAILED=false
for lang in rust python ts kotlin swift; do
  if [ -f "$TMPDIR/$lang.log" ] && [ ! -f "$TMPDIR/$lang.ok" ]; then
    cat "$TMPDIR/$lang.log"
    FAILED=true
  fi
done

if $FAILED; then
  echo ""
  echo "Pre-commit checks failed. Fix the issues above."
  echo "To bypass (NOT recommended): git commit --no-verify"
  exit 1
fi
