#!/usr/bin/env bash
# Pre-commit hook: auto-fix format, then lint (parallel).
# Auto-formats staged files and re-stages them. Lint errors block the commit.
set -euo pipefail

# The filter counts deleted paths too, and `--no-renames` lists a renamed file as a deletion
# plus an addition, so a commit that only deletes or moves files still runs the hook.
if git diff --cached --quiet --no-renames --diff-filter=ACMD; then exit 0; fi

# ── Which files this commit changes, for the language steps ──
#
# On a merge commit, the staged set lists every file the merged-in branch changed, and the
# CI of that branch already formatted and linted each of them. A language step runs here only for
# a file whose staged content differs from what a merged-in head carries: a file this
# branch changed, or a file the conflict resolution changed. So when `MERGE_HEAD` exists,
# the language flags below read the files where the staged tree differs from each merged-in
# head, and a file identical to a merged-in head's copy sets no flag. An octopus merge
# names several heads in `MERGE_HEAD`; the list is the union over all of them, so a file
# differing from any one merged-in head still sets its flag.
#
# The staged set still decides the early exit above, so the toolchain check below runs on
# every commit that stages a file, merge or not.
#
# The list also holds deleted paths, and `--no-renames` lists a renamed file as its deleted
# old path plus its added new path. A commit that deletes a `.rs` file or moves one out of a
# crate changes what that crate compiles, so the clippy scope below has to see the crate.
#
# `changed_paths` prints the list NUL-separated (`git diff -z`). Without `-z`, git wraps a
# path holding a non-ASCII byte in double quotes with octal escapes, and word splitting
# breaks a path holding a space, so such a path would match no member and no `*.rs`
# pattern. The hook calls it twice: once here, and again after the
# auto-format step, because `git add -u` in that step stages every tracked `.rs` file the
# working tree modified, and the clippy scope has to cover each file the commit will hold.
MERGE_HEAD_FILE=$(git rev-parse --git-path MERGE_HEAD)
changed_paths() {
  if [ -f "$MERGE_HEAD_FILE" ]; then
    while IFS= read -r merged_head; do
      [ -z "$merged_head" ] && continue
      git diff --cached -z --name-only --no-renames --diff-filter=ACMD "$merged_head"
    done < "$MERGE_HEAD_FILE"
  else
    git diff --cached -z --name-only --no-renames --diff-filter=ACMD
  fi
}

HAS_RUST=false
HAS_PYTHON=false
HAS_TS=false
HAS_KOTLIN=false
HAS_SWIFT=false

while IFS= read -r -d '' f; do
  case "$f" in
    *.rs) HAS_RUST=true ;;
    bindings/python/*) HAS_PYTHON=true ;;
    bindings/typescript/*) HAS_TS=true ;;
    bindings/kotlin/*) HAS_KOTLIN=true ;;
    bindings/swift/*) HAS_SWIFT=true ;;
  esac
done < <(changed_paths)

# ── The compiler this shell resolves ──
#
# `rust-toolchain.toml` names the Rust version, and rustup applies it to every cargo
# command run in this directory — unless `RUSTUP_TOOLCHAIN` is set in the environment,
# which overrides the file entirely. A shell carrying that variable formats and lints on a
# compiler the repository does not name, and a new release's lints then appear first in CI,
# against code nobody changed. That is the outage
# `.docs/lessons/pin-the-rust-toolchain-or-ci-drifts-from-local.md` records.
#
# `scripts/check-resolved-rustc.sh` holds the comparison, so this hook,
# `scripts/check-toolchain-wiring.sh`, and `scripts/setup-toolchain.sh` all read one file's
# answer.
#
# The check runs on every commit rather than only on a commit staging a `.rs` file. The
# variable belongs to the shell, not to the staged set: a commit staging `Cargo.toml`,
# `rust-toolchain.toml`, or a workflow changes how the workspace compiles and stages no
# `.rs` file at all, and its author ran `cargo clippy` by hand before writing it.
#
# git runs a hook with the working tree's top level as the working directory, so the path
# below is the same relative path every other command in this file uses.
if ! RESOLVED_RUSTC=$(bash scripts/check-resolved-rustc.sh 2>&1); then
  while IFS= read -r line; do
    if [ -n "$line" ]; then echo "  ✗ $line" >&2; fi
  done <<< "$RESOLVED_RUSTC"
  exit 1
fi

# ── Auto-format (best-effort — failures don't block other languages) ──

if $HAS_RUST; then
  echo "▸ Rust: auto-format"
  cargo fmt --all 2>/dev/null || true
  git add -u -- '*.rs' 2>/dev/null || true
fi

if $HAS_PYTHON; then
  echo "▸ Python: auto-format + auto-fix"
  python3.12 -m ruff format bindings/python/ 2>/dev/null || true
  python3.12 -m ruff check --fix bindings/python/ 2>/dev/null || true
  git add -u -- 'bindings/python/*.py' 2>/dev/null || true
fi

if $HAS_TS; then
  echo "▸ TypeScript: auto-format"
  (cd bindings/typescript && bun run format 2>/dev/null) || true
  git add -u -- 'bindings/typescript/*.ts' 2>/dev/null || true
fi

if $HAS_SWIFT; then
  echo "▸ Swift: auto-format"
  (cd bindings/swift && swiftformat . 2>/dev/null) || true
  git add -u -- 'bindings/swift/*.swift' 2>/dev/null || true
fi

# ── Lint (parallel — read-only checks that block on failure) ──

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

# ── Which workspace members clippy lints ──
#
# `scripts/pre-commit-clippy-scope.py` reads the changed paths and prints the clippy package
# arguments: each workspace member holding a changed path plus every member that depends on
# one of them, or `--workspace` when a changed path is one of the files the script's module
# docstring lists, such as `Cargo.toml`, `Cargo.lock`, or `rust-toolchain.toml`. The script
# keeps only the `CLIPPY_FEATURES` entries whose package it selects, because cargo rejects a
# feature of a package the command does not select. It prints nothing when no changed path
# sits in a workspace member, such as a commit touching only `fuzz/`, and clippy then does
# not run. CI's `rust-clippy` job lints the whole workspace on every pushed head.
#
# The hook runs the script on every commit, not only on a commit that changes a `.rs` file,
# because a commit that changes only `Cargo.lock`, `rust-toolchain.toml`, or a non-Rust file
# inside a member still needs the lint the script selects. The two protocol checks run when
# the commit changes a `.rs` file or the script prints clippy arguments. The script's
# messages and the skip notice go to `rust.log`, and the hook prints those lines after a
# passing run too.
CLIPPY_FEATURES=scp-ffi-uniffi/testing,scp-ffi/testing,scp-ffi-napi/testing,scp-core/testing,scp-runtime/testing

(
  SCOPE=$(changed_paths | python3.12 scripts/pre-commit-clippy-scope.py --features "$CLIPPY_FEATURES") \
    || { echo "▸ Rust: clippy scope"; echo "  ✗ clippy scope failed"; exit 1; }
  CLIPPY_ARGS=()
  while IFS= read -r arg; do
    if [ -n "$arg" ]; then CLIPPY_ARGS+=("$arg"); fi
  done <<< "$SCOPE"
  if [ "${#CLIPPY_ARGS[@]}" -eq 0 ] && ! $HAS_RUST; then exit 0; fi
  echo "▸ Rust: clippy + protocol enforcement"
  if [ "${#CLIPPY_ARGS[@]}" -eq 0 ]; then
    echo "  clippy skipped: no changed path is in a workspace member"
  else
    cargo clippy "${CLIPPY_ARGS[@]}" --all-targets -- -D warnings 2>&1 \
      || { echo "  ✗ clippy failed"; exit 1; }
  fi
  python3.12 scripts/check-protocol-sync.py 2>&1 || { echo "  ✗ async code in scp-protocol"; exit 1; }
  bash scripts/check-protocol-deps.sh 2>&1 || { echo "  ✗ banned deps in scp-protocol"; exit 1; }
) > "$TMPDIR/rust.log" 2>&1 && touch "$TMPDIR/rust.ok" &

if $HAS_PYTHON; then
  (
    echo "▸ Python: ruff check"
    python3.12 -m ruff check bindings/python/ 2>&1 || { echo "  ✗ ruff check failed"; exit 1; }
  ) > "$TMPDIR/python.log" 2>&1 && touch "$TMPDIR/python.ok" &
fi

if $HAS_TS; then
  (
    echo "▸ TypeScript: biome lint + tsc check"
    cd bindings/typescript
    bun run lint 2>&1 || { echo "  ✗ biome lint failed"; exit 1; }
    bun run check 2>&1 || { echo "  ✗ tsc check failed"; exit 1; }
  ) > "$TMPDIR/ts.log" 2>&1 && touch "$TMPDIR/ts.ok" &
fi

if $HAS_KOTLIN; then
  (
    echo "▸ Kotlin: detekt"
    eval "$(mise env)" 2>/dev/null || true
    cd bindings/kotlin
    ./gradlew detekt 2>&1 || { echo "  ✗ detekt failed"; exit 1; }
  ) > "$TMPDIR/kotlin.log" 2>&1 && touch "$TMPDIR/kotlin.ok" &
fi

if $HAS_SWIFT; then
  (
    echo "▸ Swift: swiftlint"
    cd bindings/swift
    swiftlint --strict 2>&1 || { echo "  ✗ swiftlint failed"; exit 1; }
  ) > "$TMPDIR/swift.log" 2>&1 && touch "$TMPDIR/swift.ok" &
fi

wait

FAILED=false
for lang in rust python ts kotlin swift; do
  if [ -f "$TMPDIR/$lang.log" ] && [ ! -f "$TMPDIR/$lang.ok" ]; then
    cat "$TMPDIR/$lang.log"
    FAILED=true
  fi
done

if [ -f "$TMPDIR/rust.ok" ]; then
  grep -E '^(clippy scope: |  clippy skipped: )' "$TMPDIR/rust.log" || true
fi

if $FAILED; then
  echo ""
  echo "Pre-commit checks failed. Fix the lint issues above."
  echo "To bypass (NOT recommended): git commit --no-verify"
  exit 1
fi
